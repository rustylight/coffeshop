<Page x:Class="CoffeeShop.Views.Barista.BaristaEarningsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мой заработок" Background="{StaticResource BgBeige}">
    <DockPanel Margin="32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,24">
            <TextBlock Text="Мой заработок" FontFamily="Playfair Display"
                       FontSize="28" FontWeight="Bold" Foreground="#2C1810" />
            <TextBlock x:Name="PeriodText" Text="Март 2026"
                       FontSize="13" Foreground="#8B7355" HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- KPI Cards -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="22" Background="#FEF3C7"
                            HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock Text="₽" FontSize="20" FontWeight="Bold" Foreground="#92400E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EarnedText" Text="0 ₽" FontSize="24" FontWeight="Bold"
                               Foreground="#2C1810" />
                    <TextBlock Text="За текущий месяц" FontSize="11" Foreground="#8B7355" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="4,0">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="22" Background="#F5F0E8"
                            HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock Text="~" FontSize="20" FontWeight="Bold" Foreground="#6F4E37"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="OrdersCountText" Text="0" FontSize="24" FontWeight="Bold"
                               Foreground="#2C1810" />
                    <TextBlock Text="Заказов выполнено" FontSize="11" Foreground="#8B7355" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="22" Background="#DBEAFE"
                            HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock Text="~" FontSize="20" FontWeight="Bold" Foreground="#1E40AF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AvgCheckText" Text="0 ₽" FontSize="24" FontWeight="Bold"
                               Foreground="#2C1810" />
                    <TextBlock Text="Средний чек" FontSize="11" Foreground="#8B7355" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Earnings table -->
        <Border Background="White" CornerRadius="12" Padding="0">
            <DataGrid x:Name="EarningsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" BorderThickness="0" Background="Transparent"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0EBE3"
                      RowBackground="White" AlternatingRowBackground="#FAFAF7"
                      HeadersVisibility="Column" FontSize="14">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F0E8" />
                        <Setter Property="Foreground" Value="#8B7355" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="160" />
                    <DataGridTextColumn Header="Смена" Binding="{Binding ShiftTimeText}" Width="160" />
                    <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="120" />
                    <DataGridTextColumn Header="Сумма" Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="OrdersTotal" StringFormat="{}{0:N0} ₽" />
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#C8956C" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Page>

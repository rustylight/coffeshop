<Page x:Class="CoffeeShop.Views.Barista.BaristaActivePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Активные заказы" Background="{StaticResource BgBeige}">
    <DockPanel Margin="32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Активные заказы" FontFamily="Playfair Display"
                       FontSize="28" FontWeight="Bold" Foreground="#2C1810" />
            <Border CornerRadius="12" Background="#FEF3C7" Padding="12,4"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="QueueCountText" Text="0 в очереди" FontSize="12"
                           Foreground="#92400E" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Header -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#2C1810">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="Заказ #{0}">
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border CornerRadius="10" Padding="10,3"
                                                Background="{Binding StatusBg}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{Binding StatusFg}" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                   Foreground="#8B7355" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Items list -->
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="13" Foreground="#2C1810" Margin="8,1,0,1">
                                                <Run Text="•" />
                                                <Run Text="{Binding Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock FontSize="12" Foreground="#8B7355" Margin="0,0,0,12">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Клиент: {0}">
                                            <Binding Path="ClientName" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <!-- Action buttons -->
                                <DockPanel>
                                    <Button Content="Детали" DockPanel.Dock="Right" Cursor="Hand"
                                            Margin="8,0,0,0" Height="40" Click="DetailsClick" Tag="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="8"
                                                        BorderBrush="#D1C7B7" BorderThickness="1"
                                                        Background="White" Padding="20,0" Height="40">
                                                    <TextBlock Text="Детали" FontSize="13"
                                                               Foreground="#2C1810" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#F5F0E8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Click="ActionClick" Tag="{Binding}" Cursor="Hand" Height="40">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="8" Height="40"
                                                        Background="{Binding ActionBg}" Padding="20,0">
                                                    <TextBlock Text="{Binding ActionText}" FontSize="13"
                                                               Foreground="White" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>

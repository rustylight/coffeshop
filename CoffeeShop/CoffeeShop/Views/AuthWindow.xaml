<Window x:Class="CoffeeShop.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoffeeShop — Вход" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#2C1810">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="480" />
        </Grid.ColumnDefinitions>

        <!-- Left dark panel -->
        <Grid Grid.Column="0" Background="#2C1810">
            <!-- Logo top-left -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="32,28,0,0">
                <Rectangle Width="32" Height="32" RadiusX="6" RadiusY="6" Margin="0,0,10,0">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/Assets/logo.png" Stretch="UniformToFill" />
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="CoffeeShop" FontFamily="Playfair Display" FontSize="18"
                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Main text at bottom-left -->
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="40,0,40,60" MaxWidth="400">
                <TextBlock FontFamily="Playfair Display" FontSize="42" FontStyle="Italic"
                           Foreground="White" TextWrapping="Wrap" Margin="0,0,0,16">
                    <Run Text="Каждый день"/><LineBreak/>
                    <Run Text="начинается"/><LineBreak/>
                    <Run Text="с хорошего кофе"/>
                </TextBlock>
                <TextBlock Text="Полная автоматизация кофейни — заказы,&#x0a;программа лояльности и персонал в одном месте"
                           FontSize="12" Foreground="#FFFFFF" Opacity="0.4"
                           TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
        </Grid>

        <!-- Right form panel -->
        <Border Grid.Column="1" Background="#F5F0E8">
            <Grid Margin="48,0">
                <StackPanel VerticalAlignment="Center" MaxWidth="384">
                    <TextBlock Text="Добро пожаловать" FontFamily="Playfair Display"
                               FontSize="28" FontWeight="Bold" Foreground="#2C1810"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Войдите, чтобы продолжить работу"
                               FontSize="13" Foreground="#8B7355" Margin="0,0,0,32"
                               FontStyle="Italic" />

                    <!-- Phone -->
                    <TextBlock Text="НОМЕР ТЕЛЕФОНА" FontSize="10" FontWeight="SemiBold"
                               Foreground="#8B7355" Margin="0,0,0,6" />
                    <Border BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="8"
                            Background="White" Margin="0,0,0,20" Height="44">
                        <TextBox x:Name="PhoneBox" Text="+7" FontSize="14" Foreground="#2C1810"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="14,0" VerticalContentAlignment="Center" />
                    </Border>

                    <!-- Password -->
                    <TextBlock Text="ПАРОЛЬ" FontSize="10" FontWeight="SemiBold"
                               Foreground="#8B7355" Margin="0,0,0,6" />
                    <Border BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="8"
                            Background="White" Margin="0,0,0,20" Height="44">
                        <PasswordBox x:Name="PasswordBox" FontSize="14" Foreground="#2C1810"
                                     BorderThickness="0" Background="Transparent"
                                     Padding="14,0" VerticalContentAlignment="Center" />
                    </Border>

                    <!-- Error -->
                    <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12"
                               Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

                    <!-- Login button -->
                    <Button Click="LoginClick" Cursor="Hand" Height="48" Margin="0,0,0,28">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8" Background="#2C1810"
                                        Height="48">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="→ " FontSize="14" Foreground="White" />
                                        <TextBlock Text="Войти в систему" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3D2B1F" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Register link -->
                    <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="#8B7355">
                        <Run Text="Нет аккаунта? " />
                        <Hyperlink Click="RegisterClick" TextDecorations="None" Foreground="#6F4E37"
                                   FontWeight="SemiBold">Зарегистрироваться</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

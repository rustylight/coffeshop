<Window x:Class="CoffeeShop.Views.Dialogs.OrderDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказа" Width="580" SizeToContent="Height"
        MaxHeight="740"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">
    <Grid Margin="20">
        <Border CornerRadius="20" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.2" Color="#2C1810" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="20" Background="White">
        <StackPanel Margin="32">
            <!-- Header -->
            <DockPanel Margin="0,0,0,16">
                <TextBlock x:Name="TitleText" Text="Детали заказа #0" FontFamily="Playfair Display"
                           FontSize="20" FontWeight="Bold" Foreground="#2C1810" />
                <Button Click="CloseClick" DockPanel.Dock="Right" Cursor="Hand"
                        HorizontalAlignment="Right">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#F5F0E8">
                                <TextBlock Text="✕" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#6F4E37"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>

            <!-- Meta row -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F9F7F5" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Клиент" FontSize="11" Foreground="#9B7464" Margin="0,0,0,4" />
                        <TextBlock x:Name="ClientText" Text="" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#2C1810" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#F9F7F5" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Время заказа" FontSize="11" Foreground="#9B7464" Margin="0,0,0,4" />
                        <TextBlock x:Name="TimeText" Text="" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#2C1810" />
                    </StackPanel>
                </Border>

                <Border x:Name="StatusBorder" Grid.Column="4" Background="#DBEAFE"
                        CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Статус" FontSize="11" Foreground="#9B7464" Margin="0,0,0,4" />
                        <TextBlock x:Name="StatusText" Text="" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1E40AF" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Divider -->
            <Border Height="1" Background="#F0EBE3" Margin="0,0,0,16" />

            <!-- Items -->
            <TextBlock Text="Состав заказа" FontSize="13" FontWeight="Bold"
                       Foreground="#2C1810" Margin="0,0,0,10" />

            <ItemsControl x:Name="ItemsList" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F9F7F5" CornerRadius="8" Padding="10,12"
                                Margin="0,0,0,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PriceText}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#2C1810"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding NameText}" FontSize="13"
                                           Foreground="#6F4E37" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Total -->
            <Border Background="#F5F0E8" CornerRadius="12" Padding="14,16" Margin="0,0,0,20">
                <DockPanel>
                    <TextBlock Text="Итого" FontSize="15" FontWeight="Bold" Foreground="#2C1810" />
                    <TextBlock x:Name="TotalText" Text="0 ₽" FontSize="18" FontWeight="Bold"
                               FontFamily="Playfair Display" Foreground="#6F4E37"
                               HorizontalAlignment="Right" />
                </DockPanel>
            </Border>

            <!-- Close button -->
            <Button Click="CloseClick" Cursor="Hand" Height="44">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Height="44" CornerRadius="10" Background="#6F4E37">
                            <TextBlock Text="Закрыть" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A3E2B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
        </Border>
    </Grid>
</Window>

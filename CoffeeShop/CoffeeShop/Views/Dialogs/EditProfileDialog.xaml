<Window x:Class="CoffeeShop.Views.Dialogs.EditProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать профиль" Width="500" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">
    <Grid Margin="20">
        <Border CornerRadius="20" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.2" Color="#2C1810" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="20" Background="White">
        <StackPanel Margin="32,28">
            <DockPanel Margin="0,0,0,24">
                <TextBlock Text="Редактировать профиль" FontFamily="Playfair Display"
                           FontSize="22" FontWeight="Bold" Foreground="#2C1810" />
                <Button Click="CancelClick" DockPanel.Dock="Right" Cursor="Hand"
                        HorizontalAlignment="Right">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#F5F0E8">
                                <TextBlock Text="✕" FontSize="12" Foreground="#8B7355"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>

            <TextBlock Text="ФИО" FontSize="13" Foreground="#2C1810" Margin="0,0,0,6" />
            <Border BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="8"
                    Background="White" Margin="0,0,0,16" Height="44">
                <TextBox x:Name="NameBox" FontSize="14" Foreground="#2C1810"
                         BorderThickness="0" Background="Transparent"
                         Padding="14,0" VerticalContentAlignment="Center" />
            </Border>

            <TextBlock Text="Email" FontSize="13" Foreground="#2C1810" Margin="0,0,0,6" />
            <Border BorderBrush="#D1C7B7" BorderThickness="1" CornerRadius="8"
                    Background="White" Margin="0,0,0,24" Height="44">
                <TextBox x:Name="EmailBox" FontSize="14" Foreground="#2C1810"
                         BorderThickness="0" Background="Transparent"
                         Padding="14,0" VerticalContentAlignment="Center" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="CancelClick" Cursor="Hand" Height="44">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Height="44" CornerRadius="22" Background="#F5F0E8">
                                <TextBlock Text="Отмена" FontSize="14" Foreground="#2C1810"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E8E0D4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Click="SaveClick" Cursor="Hand" Height="44">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Height="44" CornerRadius="22" Background="#C8956C">
                                <TextBlock Text="Сохранить" FontSize="14" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#B07D5A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
        </Border>
    </Grid>
</Window>

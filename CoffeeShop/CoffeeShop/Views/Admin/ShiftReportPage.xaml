<Page x:Class="CoffeeShop.Views.Admin.ShiftReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчёт смены" Background="{StaticResource BgBeige}">
    <DockPanel Margin="32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Отчёт по смене" FontFamily="Playfair Display"
                       FontSize="28" FontWeight="Bold" Foreground="#2C1810" />
            <Button Click="ExportClick" HorizontalAlignment="Right" Cursor="Hand" Height="40">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="#2C1810"
                                Padding="16,0" Height="40">
                            <TextBlock Text="Экспорт Excel" FontSize="13"
                                       Foreground="White" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D2B1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>

        <!-- Shift info bar -->
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="12" Padding="20"
                Margin="0,0,0,20">
            <DockPanel>
                <Button Click="CloseShiftClick" DockPanel.Dock="Right" Cursor="Hand"
                        x:Name="BtnCloseShift" Height="36">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Background="#2C1810"
                                    Padding="16,0" Height="36">
                                <TextBlock Text="Закрыть смену" FontSize="12"
                                           Foreground="White" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3D2B1F" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Дата смены" FontSize="11" Foreground="#8B7355" />
                        <TextBlock x:Name="ShiftDateText" Text="—" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#2C1810" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Время" FontSize="11" Foreground="#8B7355" />
                        <TextBlock x:Name="ShiftTimeText" Text="—" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#2C1810" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Статус" FontSize="11" Foreground="#8B7355" Margin="0,0,0,2" />
                        <Border x:Name="StatusBorder" CornerRadius="10" Padding="10,3"
                                Background="#D1FAE5" HorizontalAlignment="Left">
                            <TextBlock x:Name="StatusText" Text="Активна" FontSize="11"
                                       Foreground="#065F46" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Shift selector -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Смена:" FontSize="13" Foreground="#6F4E37" VerticalAlignment="Center"
                       Margin="0,0,12,0" FontWeight="SemiBold" />
            <ComboBox x:Name="ShiftCombo" Width="300" FontSize="13"
                      SelectionChanged="ShiftChanged" DisplayMemberPath="DisplayText" />
        </StackPanel>

        <!-- KPI Cards -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock x:Name="RevenueText" Text="0 ₽" FontSize="24" FontWeight="Bold"
                               Foreground="#2C1810" />
                    <TextBlock Text="Выручка смены" FontSize="11" Foreground="#8B7355" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="4,0">
                <StackPanel>
                    <TextBlock x:Name="OrdersCountText" Text="0" FontSize="24" FontWeight="Bold"
                               Foreground="#2C1810" />
                    <TextBlock Text="Заказов" FontSize="11" Foreground="#8B7355" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="BonusText" Text="0" FontSize="24" FontWeight="Bold"
                               Foreground="#2C1810" />
                    <TextBlock Text="Начислено бонусов" FontSize="11" Foreground="#8B7355" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Earnings table -->
        <Border Background="White" CornerRadius="12" Padding="0" Visibility="Collapsed"
                x:Name="EarningsPanel">
            <DataGrid x:Name="EarningsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" BorderThickness="0" Background="Transparent"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0EBE3"
                      RowBackground="White" AlternatingRowBackground="#FAFAF7"
                      HeadersVisibility="Column" FontSize="14">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F0E8" />
                        <Setter Property="Foreground" Value="#8B7355" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding User.FullName}" Width="*" />
                    <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="100" />
                    <DataGridTextColumn Header="Сумма" Binding="{Binding OrdersTotal, StringFormat={}{0:N0} ₽}" Width="140" />
                    <DataGridTextColumn Header="Начислено" Binding="{Binding EarnedAmount, StringFormat={}{0:N0} ₽}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Page>

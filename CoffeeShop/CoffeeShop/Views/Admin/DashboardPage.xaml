<Page x:Class="CoffeeShop.Views.Admin.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Дашборд" Background="{StaticResource BgBeige}">
    <DockPanel Margin="32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,24">
            <TextBlock Text="Дашборд" FontFamily="Playfair Display"
                       FontSize="28" FontWeight="Bold" Foreground="#2C1810" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="DateText" Text="22 марта 2026"
                           FontSize="13" Foreground="#8B7355"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button x:Name="BtnOpenShift" Click="OpenShiftClick" Cursor="Hand"
                        Margin="0,0,8,0" Height="36" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Background="#10B981"
                                    Padding="14,0" Height="36">
                                <TextBlock Text="Открыть смену" FontSize="12"
                                           Foreground="White" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#059669" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnCloseShift" Click="CloseShiftClick" Cursor="Hand" Height="36">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Background="#DC2626"
                                    Padding="14,0" Height="36">
                                <TextBlock Text="Закрыть смену" FontSize="12"
                                           Foreground="White" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#B91C1C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- KPI Cards -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="22" Background="#FEF3C7"
                            HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock Text="₽" FontSize="20" FontWeight="Bold" Foreground="#92400E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="RevenueText" Text="0 ₽" FontSize="24" FontWeight="Bold"
                               Foreground="#2C1810" />
                    <TextBlock Text="Выручка смены" FontSize="11" Foreground="#8B7355" />
                    <TextBlock x:Name="RevenueChangeText" Text="" FontSize="11"
                               Foreground="#10B981" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="4,0">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="22" Background="#F5F0E8"
                            HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock Text="#" FontSize="20" FontWeight="Bold" Foreground="#6F4E37"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="OrdersText" Text="0" FontSize="24" FontWeight="Bold"
                               Foreground="#2C1810" />
                    <TextBlock Text="Заказов сегодня" FontSize="11" Foreground="#8B7355" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="22" Background="#DBEAFE"
                            HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock Text="☺" FontSize="20" FontWeight="Bold" Foreground="#1E40AF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="BaristaCountText" Text="0" FontSize="24" FontWeight="Bold"
                               Foreground="#2C1810" />
                    <TextBlock Text="Бариста на смене" FontSize="11" Foreground="#8B7355" />
                    <TextBlock x:Name="BaristaInfoText" Text="" FontSize="11"
                               Foreground="#8B7355" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom section: Orders + Top drinks -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- Recent orders -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock Text="Последние заказы" FontSize="16" FontWeight="SemiBold"
                               Foreground="#2C1810" DockPanel.Dock="Top" Margin="0,0,0,16" />
                    <ItemsControl x:Name="RecentOrdersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Right" FontSize="14" FontWeight="Bold"
                                               Foreground="#2C1810" VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:N0} ₽">
                                                <Binding Path="FinalAmount" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2"
                                            Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E5E7EB" />
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToRussian}}"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock FontSize="14" Foreground="#2C1810" VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="#{0}">
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Top drinks -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">
                <DockPanel>
                    <TextBlock Text="Выбор гостей" FontSize="16" FontWeight="SemiBold"
                               Foreground="#2C1810" DockPanel.Dock="Top" Margin="0,0,0,16" />
                    <ItemsControl x:Name="TopDrinksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Rank}" FontSize="13"
                                               Foreground="#C8956C" FontWeight="SemiBold"
                                               Width="20" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               Foreground="#2C1810" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CountText}" FontSize="12"
                                               Foreground="#8B7355" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Page>

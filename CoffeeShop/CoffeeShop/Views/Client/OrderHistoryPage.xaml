<Page x:Class="CoffeeShop.Views.Client.OrderHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="История заказов" Background="{StaticResource BgBeige}">
    <DockPanel Margin="32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,24">
            <TextBlock Text="История заказов" FontFamily="Playfair Display"
                       FontSize="28" FontWeight="Bold" Foreground="#2C1810" />
            <Border CornerRadius="12" Background="#F5F0E8" Padding="12,4"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="OrderCountText" Text="0 заказов" FontSize="12"
                           Foreground="#8B7355" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                            <DockPanel>
                                <!-- Price right -->
                                <TextBlock DockPanel.Dock="Right" FontSize="15" FontWeight="Bold"
                                           Foreground="#2C1810" VerticalAlignment="Top" Margin="16,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:N0} ₽">
                                            <Binding Path="FinalAmount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <!-- Coffee icon -->
                                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24"
                                        Background="#FEF3C7" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <TextBlock Text="☕" FontSize="20" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Content -->
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#2C1810">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Заказ #{0}">
                                                    <Binding Path="Id" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Right"
                                                Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E5E7EB" />
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToRussian}}"
                                                       FontSize="11" Foreground="#6B7280" FontWeight="SemiBold" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding ItemsSummary}" FontSize="12"
                                               Foreground="#8B7355" Margin="0,0,0,2" />
                                    <TextBlock FontSize="11" Foreground="#B0A08C">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:dd MMMM yyyy · HH:mm}">
                                                <Binding Path="CreatedAt" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>

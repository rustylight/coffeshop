<Page x:Class="CoffeeShop.Views.Client.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Меню" Background="{StaticResource BgBeige}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Category sidebar -->
        <StackPanel Grid.Column="0" Margin="20,28,0,0">
            <TextBlock Text="КАТЕГОРИИ" FontSize="11" FontWeight="SemiBold"
                       Foreground="#8B7355" Margin="0,0,0,16" />
            <ItemsControl x:Name="CategoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding Name}" Click="CategoryClick" Cursor="Hand" Margin="0,0,0,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Padding="10,8" CornerRadius="6"
                                            Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Icon" FontSize="16" Margin="0,0,6,0"
                                                       VerticalAlignment="Center" Foreground="#6F4E37" />
                                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                       FontSize="13" Foreground="#2C1810" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E8E0D4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Menu items -->
        <DockPanel Grid.Column="1" Margin="20,24,20,24">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <TextBlock x:Name="CategoryTitle" Text="Кофе" FontSize="26" FontWeight="Bold"
                           Foreground="#2C1810" FontFamily="Playfair Display" />
                <TextBlock x:Name="CategoryDesc" Text="Бодрящие зёрна, приготовленные с любовью"
                           FontSize="13" Foreground="#8B7355" Margin="0,4,0,0" FontStyle="Italic" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MenuList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="12" Padding="16"
                                    Margin="0,0,12,12" Width="175">
                                <StackPanel>
                                    <Border Width="44" Height="44" CornerRadius="10"
                                            Background="#F5F0E8" HorizontalAlignment="Center"
                                            Margin="0,4,0,8">
                                        <TextBlock x:Name="ItemIcon" Text="☕" FontSize="22"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#2C1810" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="#8B7355" TextWrapping="Wrap"
                                               MaxHeight="32" Margin="0,2,0,8" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="Bold"
                                                   Foreground="#6F4E37" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:N0} ₽">
                                                    <Binding Path="Price" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="+" Click="AddToCartClick" Tag="{Binding}"
                                                    Width="32" Height="32" FontSize="16" FontWeight="Bold"
                                                    Foreground="White" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="#6F4E37"
                                                                CornerRadius="8" Width="32" Height="32">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#5A3E2B" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Cart -->
        <Border Grid.Column="2" Background="White" Margin="0,0,0,0" Padding="20,24">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Ваш заказ" FontSize="18" FontWeight="Bold"
                               Foreground="#2C1810" />
                    <Border CornerRadius="10" Background="#C8956C" Padding="8,2"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="CartCountText" Text="0" FontSize="11"
                                   Foreground="White" FontWeight="Bold" />
                    </Border>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,8" />

                    <!-- Bonus section -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Списать бонусы" FontSize="12" Foreground="#8B7355"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ApplyBonusBtn" Click="ApplyBonusClick"
                                HorizontalAlignment="Right" Cursor="Hand" Height="28">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#C8956C" CornerRadius="6"
                                            Padding="10,4" Height="28">
                                        <TextBlock x:Name="BtnText" Text="Применить бонусы" FontSize="11"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#B07D5A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>

                    <StackPanel x:Name="BonusPanel" Visibility="Collapsed" Margin="0,0,0,8">
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="AvailableBonusText" Text="Доступно: 0 бонусов"
                                       FontSize="11" Foreground="#8B7355" VerticalAlignment="Center" />
                            <Button Content="✕" Click="CancelBonusClick" HorizontalAlignment="Right"
                                    Cursor="Hand" Width="20" Height="20" FontSize="10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#F5F0E8" CornerRadius="4" Width="20" Height="20">
                                            <TextBlock Text="✕" FontSize="10" Foreground="#8B7355"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>
                        <TextBox x:Name="BonusInput" Text="0" Style="{StaticResource CoffeeTextBox}"
                                 FontSize="13" Padding="8,6" TextChanged="BonusChanged"
                                 PreviewTextInput="BonusPreviewInput"
                                 DataObject.Pasting="BonusPasting" />
                    </StackPanel>

                    <DockPanel Margin="0,0,0,4" x:Name="BonusAppliedPanel" Visibility="Collapsed">
                        <TextBlock Text="Бонусы:" FontSize="12" Foreground="#8B7355" />
                        <TextBlock x:Name="BonusDiscountText" Text="-0 ₽" FontSize="12"
                                   Foreground="#4CAF50" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Итого" FontSize="16" FontWeight="Bold" Foreground="#2C1810" />
                        <TextBlock x:Name="FinalText" Text="0 ₽" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Right" Foreground="#2C1810" />
                    </DockPanel>

                    <Button Click="PlaceOrderClick" x:Name="PlaceOrderBtn" IsEnabled="False"
                            Cursor="Hand" Height="44">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Height="44" CornerRadius="22"
                                        Background="#6F4E37">
                                    <TextBlock Text="Оформить заказ →" FontSize="14"
                                               FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#5A3E2B" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <Grid>
                    <!-- Empty cart placeholder -->
                    <StackPanel x:Name="EmptyCartPanel" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Visibility="Visible">
                        <TextBlock Text="🛒" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Корзина пуста" FontSize="13" Foreground="#8B7355"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Добавьте товары из меню" FontSize="11" Foreground="#B8A89A"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer x:Name="CartScroll" VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,0,8" Visibility="Collapsed">
                    <ItemsControl x:Name="CartList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FDFBF7" CornerRadius="8" Padding="10,8"
                                        Margin="0,0,0,6" BorderBrush="#EDE8DF" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="13" Foreground="#2C1810"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Margin="8,0,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:N0} ₽">
                                                    <Binding Path="Subtotal" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#2C1810" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Width="26" Height="26" FontSize="12"
                                                        Click="DecreaseQtyClick" Tag="{Binding}" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="#E8E0D4" CornerRadius="6"
                                                                    Width="26" Height="26">
                                                                <TextBlock Text="−" FontSize="14" FontWeight="Bold"
                                                                           Foreground="#6F4E37"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#D1C7B7" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock Text="{Binding Quantity}" FontSize="13"
                                                           FontWeight="Bold" Margin="10,0"
                                                           Foreground="#2C1810" VerticalAlignment="Center" />
                                                <Button Width="26" Height="26" FontSize="12"
                                                        Click="IncreaseQtyClick" Tag="{Binding}" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="#6F4E37" CornerRadius="6"
                                                                    Width="26" Height="26">
                                                                <TextBlock Text="+" Foreground="White" FontSize="14"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="#5A3E2B" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Page>
